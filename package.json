{
  "name": "shirt-designs",
  "version": "1.0.0",
  "private": true,
  "description": "All-in-one t-shirt design studio: mobile web app plus print production service",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "npm run start --workspace @shirt-designs/server",
    "dev": "npm run dev --workspace @shirt-designs/server",
    "test": "npm run test --workspace @shirt-designs/server && node --test web/test/*.test.mjs",
    "fonts:sync": "npm run fonts:sync --workspace @shirt-designs/server",
    "test:web": "node --test web/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}